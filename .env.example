# ==============================================================================
# JARVIS AI ASSISTANT BACKEND CONFIGURATION v2.1
# ==============================================================================

# Server & Security
APP_ENV=production
PORT=8000
MAX_UPLOAD_MB=15
CORS_ALLOWED_ORIGINS=*

# Security Secrets (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
APP_SECRET_KEY=generate_a_random_32_byte_secret_key
JWT_SECRET_KEY=generate_a_random_jwt_secret_key
TOKEN_ENCRYPTION_KEY=generate_a_random_encryption_key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Legacy token for APK or direct tool integration
APP_API_TOKEN=your-random-api-token-here
ALLOW_NO_AUTH=false

# ------------------------------------------------------------------------------
# Google OAuth 2.0 & Gmail Integration
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://<your-render-service>.onrender.com/api/auth/google/callback
DEFAULT_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# AI Provider Configuration & Order
# Providers are tried in order. If one fails, automatic fallback engages.
# ------------------------------------------------------------------------------
LLM_PROVIDER_ORDER=llm7,pollinations,groq,gemini,openai,claude

# Keyless Free Providers
LLM7_API_KEY=
LLM_LLM7_MODEL=gpt-oss:20b
LLM_POLLINATIONS_MODEL=openai

# Commercial AI Providers
GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=claude-3-5-sonnet-latest

# Optional Hugging Face Token (for multi-modal tasks like image captioning)
HUGGINGFACE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Database Storage (SQLite default for zero-setup, PostgreSQL for production)
# ------------------------------------------------------------------------------
DATABASE_URL=
SQLITE_PATH=jarvis.db
FILE_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Keep-Alive Self-Pinger for Render Free Tier
# ------------------------------------------------------------------------------
KEEPALIVE_ENABLED=true
PING_INTERVAL_SECONDS=240
