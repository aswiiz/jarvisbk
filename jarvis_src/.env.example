# ==============================================================================
# JARVIS AI ASSISTANT BACKEND CONFIGURATION
# ==============================================================================

# Server Environment
APP_ENV=production
PORT=8000
MAX_UPLOAD_MB=15
CORS_ALLOWED_ORIGINS=*

# Security Token (Required for API access from Android client; sent as X-API-Token or Bearer)
# Generate with: python -c "import secrets; print(secrets.token_hex(24))"
APP_API_TOKEN=your-random-token-here

# Set to true to allow local testing without APP_API_TOKEN
ALLOW_NO_AUTH=false

# ------------------------------------------------------------------------------
# AI Provider Configuration & Order
# Providers are tried in order. If one hits rate limit or errors, it falls back to next.
# Supported: llm7, pollinations, groq, gemini, openai, claude, custom
# ------------------------------------------------------------------------------
LLM_PROVIDER_ORDER=llm7,pollinations,groq,gemini,openai,claude

# Free / Keyless Providers
LLM7_API_KEY=
LLM_LLM7_MODEL=gpt-oss:20b

LLM_POLLINATIONS_MODEL=openai

# Commercial / Cloud AI Providers
GROQ_API_KEY=
LLM_GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
LLM_CLAUDE_MODEL=claude-3-5-sonnet-latest

# Optional Custom OpenAI-compatible Provider
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Hugging Face (Optional: for local multi-modal tasks like image captioning, FLUX text-to-image)
HUGGINGFACE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# Google Calendar & Gmail OAuth
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEFAULT_TIMEZONE=Asia/Kolkata

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Database Storage (SQLite default for zero-setup, PostgreSQL or MongoDB for production)
# ------------------------------------------------------------------------------
DATABASE_URL=
SQLITE_PATH=jarvis.db
MONGODB_URI=
MONGODB_DB=jarvis
FILE_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Keep-Alive Self-Pinger for Render Free Tier
# ------------------------------------------------------------------------------
KEEPALIVE_ENABLED=true
PING_INTERVAL_SECONDS=240
